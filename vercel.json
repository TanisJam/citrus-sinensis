{
  "redirects": [
    {
      "source": "/(.*)",
      "has": [{ "type": "host", "value": "mnr.ar" }],
      "destination": "https://www.mnr.ar/$1",
      "permanent": true
    }
  ],
  "rewrites": [
    { "source": "/lab/tree-3d", "destination": "/index.html" },
    { "source": "/lab/tree-3d/", "destination": "/index.html" },
    {
      "source": "/(.+)",
      "destination": "https://mauricioromero.vercel.app/$1"
    }
  ]
}
